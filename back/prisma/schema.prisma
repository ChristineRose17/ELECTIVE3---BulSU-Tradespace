// Prisma schema file for BulSU Tradespace
// Supabase PostgreSQL configuration with connection pooling & direct migration URL

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------------------------------------------------
// User — Supabase Auth handles password hashing & JWT.
// supabaseId links this profile to the Supabase auth.users table.
// Profile fields are optional at signup and filled in on the Profile page.
// -----------------------------------------------------------------------
model User {
  id               Int      @id @default(autoincrement())

  // --- Supabase Auth link (UUID from auth.users) ---
  supabaseId       String   @unique  // Supabase auth.users.id (UUID)

  // --- Basic identity (required at signup) ---
  email            String   @unique
  name             String

  // --- Role & Profile Completion ---
  // role: "student" | "faculty" | "staff" — set during profile completion
  role             String?
  profileCompleted Boolean  @default(false)

  // --- Student-specific fields ---
  studentId        String?  @unique  // e.g. "2022-108249"
  course           String?           // e.g. "BS Information Technology"
  year             String?           // e.g. "3rd Year"

  // --- Faculty/Staff shared fields ---
  employeeId       String?           // e.g. "EMP-2024-001"
  position         String?           // e.g. "Instructor I", "Administrative Officer"
  office           String?           // e.g. "Office of the Registrar" (staff only)

  // --- Shared profile fields ---
  college          String?           // e.g. "CIT / Engineering"
  campus           String   @default("Meneses Campus")
  phone            String?           // e.g. "0917-123-4567"
  bio              String?
  avatar           String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  listings           Listing[]
  claims             Claim[]
  savedItems         SavedItem[]
  notifications      Notification[] @relation("RecipientNotifications")
  actedNotifications Notification[] @relation("ActorNotifications")
  buyerRequests      TradeRequest[] @relation("BuyerTradeRequests")
  sellerRequests     TradeRequest[] @relation("SellerTradeRequests")
  tradeEvents        TradeRequestEvent[]

  @@map("users")
}

model Listing {
  id          Int         @id @default(autoincrement())
  status      String      @default("active") // "active" (available), "reserved", "sold", "draft"
  title       String
  category    String
  college     String
  campus      String      @default("Meneses Campus")
  condition   String
  description String      @db.Text
  type        String      @default("For Sale") // "For Sale", "Item Swap", "Giveaway", "Service"
  price             Float       @default(0)
  images            String[]    // Array of image URLs or storage paths
  preferredLocation String?     @map("preferred_location")

  sellerId    Int
  seller      User        @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  claims         Claim[]
  savedBy        SavedItem[]
  notifications  Notification[]
  tradeRequests  TradeRequest[]
  availabilities ListingAvailability[]

  @@map("listings")
}

model Claim {
  id          Int         @id @default(autoincrement())
  listingId   Int
  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  claimantId  Int
  claimant    User        @relation(fields: [claimantId], references: [id], onDelete: Cascade)

  status      String      @default("pending") // "pending", "accepted", "declined", "completed"
  notes       String?     @db.Text
  claimDate   DateTime    @default(now())

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  notifications Notification[]

  @@map("claims")
}

model SavedItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId Int
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("saved_items")
}

model ListingAvailability {
  id        Int      @id @default(autoincrement())
  listingId Int      @map("item_id")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  dayOfWeek Int      @map("day_of_week") // 0 = Sun, 1 = Mon, 2 = Tue, 3 = Wed, 4 = Thu, 5 = Fri, 6 = Sat
  startTime String   @map("start_time") // HH:mm
  endTime   String   @map("end_time")   // HH:mm
  createdAt DateTime @default(now()) @map("created_at")

  @@map("listing_availability")
  @@index([listingId])
}

model TradeRequest {
  id             Int       @id @default(autoincrement())
  listingId      Int       @map("item_id")
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId        Int       @map("buyer_id")
  buyer          User      @relation("BuyerTradeRequests", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId       Int       @map("seller_id")
  seller         User      @relation("SellerTradeRequests", fields: [sellerId], references: [id], onDelete: Cascade)

  meetupLocation String    @map("meetup_location")
  meetupDate     String    @map("meetup_date") // YYYY-MM-DD
  meetupTime     String    @map("meetup_time") // HH:mm (24h)
  notes          String?   @db.Text
  status         String    @default("pending") // pending | countered | accepted | declined | cancelled | expired | completed
  proposedBy     String    @default("buyer") @map("proposed_by") // buyer | seller
  declineReason  String?   @map("decline_reason") @db.Text
  customTime     Boolean   @default(false) @map("custom_time")

  expiresAt      DateTime? @map("expires_at")
  respondedAt    DateTime? @map("responded_at")
  completedAt    DateTime? @map("completed_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  events         TradeRequestEvent[]
  notifications  Notification[]

  @@map("trade_requests")
}

model TradeRequestEvent {
  id               Int          @id @default(autoincrement())
  requestId        Int          @map("request_id")
  request          TradeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId          Int          @map("actor_id")
  actor            User         @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action           String       // created | accepted | declined | countered | cancelled | completed | expired
  snapshotLocation String?      @map("snapshot_location")
  snapshotDate     String?      @map("snapshot_date")
  snapshotTime     String?      @map("snapshot_time")
  notes            String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("trade_request_events")
}

model Notification {
  id               Int           @id @default(autoincrement())
  userId           Int           @map("user_id")
  user             User          @relation("RecipientNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actorId          Int?          @map("actor_id")
  actor            User?         @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: Cascade)
  type             String
  title            String?
  message          String        @db.Text
  relatedRequestId Int?          @map("related_request_id")
  relatedRequest   TradeRequest? @relation(fields: [relatedRequestId], references: [id], onDelete: Cascade)
  relatedItemId    Int?          @map("related_item_id")
  listingId        Int?          @map("listing_id")
  listing          Listing?      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  claimId          Int?          @map("claim_id")
  claim            Claim?        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  isRead           Boolean       @default(false) @map("is_read")
  createdAt        DateTime      @default(now()) @map("created_at")

  @@map("notifications")
}
